---
import '../styles/glass.css';
import '../styles/ui.css';
import { ENABLED_LOCALES } from '../data/locales';
import objects from '../data/objects.json';
import Base from '../layouts/Base.astro';

const title = 'Scale of the Universe 2026';
const description = `From the Planck length to the observable universe: ${objects.length} objects drawn to scale, with sizes checked against current sources.`;
---

<Base lang="en" title={title} description={description}>
  <main class="landing">
    <section class="panel glass">
      <p class="eyebrow">2026 edition</p>
      <h1>Scale of the Universe</h1>
      <p class="lede">
        {objects.length} objects, from the Planck length to the observable universe, drawn to scale on one continuous zoom.
      </p>

      <nav class="languages" aria-label="Choose a language">
        {
          ENABLED_LOCALES.map((locale) => (
            <a class="btn" href={`${import.meta.env.BASE_URL}${locale.code}/`} hreflang={locale.code} lang={locale.code} dir={locale.dir}>
              {locale.name}
            </a>
          ))
        }
      </nav>

      <div class="notes">
        <p>
          An independent reinterpretation of{' '}
          <a href="https://scaleofuniverse.com/">Scale of the Universe</a>{' '}
          by Cary and Michael Huang. The idea and the list of objects come from their work; artwork, text, code and music
          here are new. Go and see the original.
        </p>
        <p>
          Built as an experiment to try Claude Fable 5.2, Anthropic's model, which wrote the code and the text, checked the data and chose
          the images on its own. No person has reviewed the result, so it may contain errors. Italian is the original language; the others
          are automatic translations.
        </p>
        <p>No cookies, no tracking, no analytics. Your language choice stays in your browser.</p>
      </div>

      <p class="signature">A project by <a href="https://calicchia.design/">Federico Calicchia</a></p>
    </section>
  </main>

  <script>
    // Remember the last language chosen and mark it. Storage can be blocked
    // (private windows), so every access is guarded and the links work without it.
    const KEY = 'sotu.lang';
    const links = document.querySelectorAll<HTMLAnchorElement>('.languages a');
    let last: string | null = null;
    try {
      last = localStorage.getItem(KEY);
    } catch {
      last = null;
    }
    for (const link of links) {
      if (link.hreflang === last) link.dataset.last = 'true';
      link.addEventListener('click', () => {
        try {
          localStorage.setItem(KEY, link.hreflang);
        } catch {
          /* storage unavailable: nothing to remember */
        }
      });
    }
  </script>
</Base>

<style>
  :global(body) {
    overflow: auto;
    background:
      radial-gradient(1px 1px at 12% 18%, rgba(255, 255, 255, 0.7), transparent 60%),
      radial-gradient(1px 1px at 78% 12%, rgba(255, 255, 255, 0.55), transparent 60%),
      radial-gradient(1.5px 1.5px at 64% 72%, rgba(255, 255, 255, 0.6), transparent 60%),
      radial-gradient(1px 1px at 28% 84%, rgba(255, 255, 255, 0.5), transparent 60%),
      radial-gradient(1px 1px at 90% 54%, rgba(255, 255, 255, 0.45), transparent 60%),
      radial-gradient(1.5px 1.5px at 42% 36%, rgba(255, 255, 255, 0.5), transparent 60%),
      radial-gradient(120% 90% at 50% 40%, rgb(46, 54, 84), rgb(13, 16, 29) 70%);
    background-attachment: fixed;
  }
  .landing {
    min-height: 100%;
    display: grid;
    place-items: center;
    padding: 24px 16px;
  }
  .panel {
    width: min(560px, 100%);
    padding: 32px;
    border-radius: 36px;
  }
  .eyebrow {
    margin: 0 0 8px;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(32px, 7vw, 44px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .lede {
    margin: 12px 0 24px;
    font-size: 17px;
    line-height: 1.5;
    color: var(--muted);
  }
  .languages {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .languages a {
    display: inline-flex;
    align-items: center;
    color: var(--text);
    text-decoration: none;
  }
  .languages a[data-last='true'] {
    background: linear-gradient(135deg, rgba(255, 220, 160, 0.55), rgba(255, 190, 110, 0.22));
    border-color: rgba(255, 225, 170, 0.8);
  }
  .notes {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 10px;
  }
  .notes p {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 62ch;
  }
  .notes a,
  .signature a {
    color: var(--teal);
  }
  .signature {
    margin: 20px 0 0;
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 480px) {
    .panel {
      padding: 24px 20px;
      border-radius: 28px;
    }
  }
</style>
