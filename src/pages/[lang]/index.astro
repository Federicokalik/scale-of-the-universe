---
import '../../styles/glass.css';
import '../../styles/ui.css';
import { ENABLED_LOCALES, type Locale } from '../../data/locales';
import { FLAG_COLOUR, FLAG_ORDER, ZOOM_MAX, ZOOM_MIN, ZOOM_START } from '../../engine/constants';
import Base from '../../layouts/Base.astro';
import { loadSceneData } from '../../lib/data';
import { fill } from '../../lib/format';
import { countSources, sourceIndex } from '../../lib/sources';

export function getStaticPaths() {
  return ENABLED_LOCALES.map((locale) => ({ params: { lang: locale.code }, props: { locale } }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = await loadSceneData(locale.code);
const { ui, objects } = data;

const count = (flag: string) => objects.filter((o) => o.flags.some((f) => f === flag)).length;
const sourceGroups = sourceIndex(objects);
const photos = objects.filter((o) => o.image && o.imageShape !== 'art' && o.credit).sort((a, b) => a.name.localeCompare(b.name, locale.code));
const totals = {
  n: objects.length,
  r: count('r'),
  new: count('n'),
  i: count('i'),
  u: count('u'),
  verified: objects.filter((o) => o.verified).length,
  sources: countSources(sourceGroups),
  sites: sourceGroups.length,
  photos: photos.length,
  art: objects.filter((o) => o.imageShape === 'art').length,
};
/** The music strings carry a leading note sign from the draft; the button now draws its own icon. */
const bare = (text: string) => text.replace(/^♪\s*/, '');
const flagVar = { r: 'var(--accent)', n: 'var(--teal)', i: 'var(--violet)', u: 'var(--grey)' };

// Inlined for the client script. "<" is escaped so no description can close the script tag.
const payload = JSON.stringify(data).replace(/</g, '\\u003c');
---

<Base lang={locale.code} dir={locale.dir} title={ui['title.full']} description={fill(ui['description'], totals)}>
  <Fragment slot="head">
    {ENABLED_LOCALES.map((l) => <link rel="alternate" hreflang={l.code} href={new URL(`${import.meta.env.BASE_URL}${l.code}/`, Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(import.meta.env.BASE_URL, Astro.site)} />
  </Fragment>
  <canvas id="stage" role="img" aria-label={ui['canvas.label']}></canvas>

  <div class="top">
    <div class="brand">
      <h1>{ui['title']}</h1>
      <p>{ui['subtitle']} · <span id="count">{fill(ui['count'], totals)}</span></p>
      <div class="chips" id="chips">
        {
          FLAG_ORDER.map((flag) => (
            <button class="chip" data-flag={flag} aria-pressed="false">
              <span class="dot" style={`background:${FLAG_COLOUR[flag]}`} />
              {ui[`flag.${flag}`]} · {count(flag)}
            </button>
          ))
        }
      </div>
    </div>
    <div class="tools">
      <div class="search">
        <input id="q" type="search" placeholder={ui['search.placeholder']} autocomplete="off" aria-label={ui['search.label']} />
        <div class="results glass" id="results"></div>
      </div>
      <button class="btn icon" id="music" aria-pressed="false">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V6l10-2v12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6.5" cy="18" r="2.5" fill="currentColor"/><circle cx="16.5" cy="16" r="2.5" fill="currentColor"/></svg>
        <span class="lbl" id="musicLabel">{bare(ui['music.off'])}</span>
      </button>
      <input class="vol" id="vol" type="range" min="0" max="1" step="0.01" value="0.6" aria-label={ui['volume.label']} />
      <button class="btn icon" id="about">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 11v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="7.6" r="1.2" fill="currentColor"/></svg>
        <span class="lbl">{ui['about.button']}</span>
      </button>
      <label class="btn icon lang">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3 12h18M12 3c3 3.2 3 14.800 0 18M12 3c-3 3.2-3 14.800 0 18" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        <span class="lbl" aria-hidden="true">{locale.name}</span>
        <select id="lang" aria-label={ui['language.label']} data-base={import.meta.env.BASE_URL}>
          {ENABLED_LOCALES.map((l) => <option value={l.code} lang={l.code} selected={l.code === locale.code}>{l.name}</option>)}
        </select>
      </label>
    </div>
  </div>

  <aside class="card glass" id="card" aria-live="polite">
    <button class="x" id="close" aria-label={ui['card.close']}>×</button>
    <div class="kind" id="cKind"></div>
    <h2 id="cName"></h2>
    <div class="size" id="cSize"></div>
    <div class="sci" id="cSci"></div>
    <div class="badges" id="cBadges"></div>
    <figure class="photo" id="cFigure" hidden>
      <img id="cImg" alt="" width="800" height="600" decoding="async" />
      <figcaption id="cCredit"></figcaption>
    </figure>
    <p id="cNote"></p>
    <p class="cmp" id="cCmp"></p>
    <div class="sources" id="cSources" hidden></div>
    <div class="nav"><button id="prev"></button><button id="next"></button></div>
  </aside>

  <div class="bottom glass">
    <div class="read">
      <span class="pretty" id="pretty"></span>
      <span class="regime" id="regime"></span>
    </div>
    <div class="slide">
      <button class="step" id="minus" aria-label={ui['zoom.out']}>−</button>
      <input id="zoom" type="range" min={ZOOM_MIN} max={ZOOM_MAX} step="0.01" value={ZOOM_START} aria-label={ui['zoom.label']} />
      <button class="step" id="plus" aria-label={ui['zoom.in']}>+</button>
    </div>
    <div class="hint">{ui['hint']}</div>
  </div>

  <dialog class="glass" id="dlg">
    <button class="x" id="dlgX" aria-label={ui['dialog.close']}>×</button>
    <h2>{ui['dialog.title']}</h2>
    <p set:html={ui['dialog.intro']} />
    <p>{ui['dialog.experiment']}</p>
    <p>{ui['dialog.translation']}</p>

    <h3>{ui['dialog.contents.title']}</h3>
    <p id="dlgCount">{fill(ui['dialog.contents.count'], totals)}</p>
    <ul>
      {
        FLAG_ORDER.map((flag) => (
          <li>
            <b style={`color:${flagVar[flag]}`}>{ui[`flag.${flag}`]}</b>: {ui[`dialog.flag.${flag}`]}
          </li>
        ))
      }
    </ul>

    <h3>{ui['dialog.diff.title']}</h3>
    <p>{ui['dialog.diff.intro']}</p>
    <ul>
      {['values', 'new', 'flags', 'art', 'open'].map((key) => <li>{fill(ui[`dialog.diff.${key}`], totals)}</li>)}
    </ul>

    <h3>{ui['dialog.sizes.title']}</h3>
    <p>{ui['dialog.sizes.body']}</p>

    <h3>{ui['dialog.sources.title']}</h3>
    <p>{fill(ui['dialog.sources.intro'], totals)}</p>
    <details class="source-list">
      <summary>{fill(ui['dialog.sources.all'], totals)}</summary>
      {
        sourceGroups.map((group) => (
          <section>
            <h4>
              {group.host} <span>{group.sources.length}</span>
            </h4>
            <ul>
              {group.sources.map((source) => (
                <li>
                  <a href={source.url} rel="noopener">
                    {source.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </details>

    <h3>{ui['dialog.images.title']}</h3>
    <p>{fill(ui['dialog.images.intro'], totals)}</p>
    {
      photos.length > 0 && (
        <details class="source-list">
          <summary>{fill(ui['dialog.images.all'], totals)}</summary>
          <ul>
            {photos.map((o) => (
              <li>
                {o.name}:{' '}
                <a href={o.credit!.page} rel="noopener">
                  {o.credit!.author}
                </a>
                , {o.credit!.licence}
              </li>
            ))}
          </ul>
        </details>
      )
    }

    <h3>{ui['dialog.ui.title']}</h3>
    <ul>
      {['concept', 'type', 'art', 'music', 'stack'].map((key) => <li set:html={ui[`dialog.ui.${key}`]} />)}
    </ul>

    <h3>{ui['dialog.privacy.title']}</h3>
    <p>{ui['dialog.privacy.body']}</p>

    <p set:html={ui['dialog.author']} />
    <button class="btn" id="dlgClose">{ui['dialog.close']}</button>
  </dialog>

  <script type="application/json" id="scene-data" set:html={payload} />
  <script>
    import { mountScene } from '../../engine/main';

    const data = JSON.parse(document.getElementById('scene-data')!.textContent!);
    mountScene(document.body, data);
  </script>
</Base>
